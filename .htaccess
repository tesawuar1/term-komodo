# Serve clean URLs without the .html extension
# e.g. /full-day-trip loads full-day-trip.html

RewriteEngine On

# If someone requests the .html URL directly, redirect to the clean version
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve the matching .html file for a clean URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]
